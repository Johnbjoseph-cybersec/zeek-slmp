[package]
script_dir = scripts
test_command = cd testing && btest -c btest.cfg
summary = Spicy-based Zeek analyzer for SLMP (SeamLess Message Protocol), binary 3E/4E frames over TCP and UDP
description = Parses and logs the binary encoding of SLMP, the message
    protocol used by Mitsubishi Electric MELSEC controllers and other
    SLMP-compatible devices: 3E, 4E and station number extension frames,
    command and subcommand, device access details and end codes. Writes
    slmp.log with one line per request/response pair.
tags = ics, ot, scada, slmp, melsec, spicy, protocol-analyzer
depends =
    zeek >=6.0.0
build_command = mkdir -p build && cd build && cmake .. && cmake --build .
